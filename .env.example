# Browser-visible backend URL used while building ChatUI.
REACT_APP_BACKEND_URL=http://localhost:8000

# Service account key used by kubernetes-mcp to auth to Cloud Build + GKE
# (see devops-agent-sa in project-2026-486210). Never commit this file.
GCP_SA_KEY_PATH=/home/abhi/.config/gcp-sa/devops-agent-sa.json
KUBE_CONFIG_DIR=/home/abhi/.kube

# GCP project the deploy tool builds/deploys into. Must have billing enabled.
GCP_PROJECT_ID=project-2026-486210
ARTIFACT_REGISTRY_REPO=coding-agent-project
ARTIFACT_REGISTRY_REGION=us-central1
